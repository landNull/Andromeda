#!/bin/sh
# andromeda — thin dispatcher. Logic lives in andromeda-lib/*.sh
# Do not sudo this wrapper.

set -eu

PROG=${0##*/}
DRYRUN=0
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if [ -n "${SUDO_USER:-}" ] || [ "$(id -u)" -eq 0 ]; then
  echo "$PROG: do not run this with sudo or as root." >&2
  echo "$PROG: log in as your operator account (or deploy) and run: $PROG …" >&2
  echo "$PROG: the wrapper calls sudo -n only for the few root steps." >&2
  exit 2
fi

find_lib() {
  for d in \
    "${ANDROMEDA_LIB:-}" \
    "$HERE/lib" \
    "$HERE/../lib" \
    "$HERE/andromeda-lib" \
    /usr/local/lib/andromeda \
    /srv/andromeda/lib
  do
    if [ -n "$d" ] && [ -f "$d/common.sh" ]; then
      echo "$d"
      return 0
    fi
  done
  return 1
}

LIBDIR=$(find_lib) || {
  echo "$PROG: cannot find lib/common.sh. Clone the andromeda repo and run ./andromeda-install.sh from its root." >&2
  exit 1
}
export LIBDIR

# shellcheck disable=SC1091
. "$LIBDIR/common.sh"
# shellcheck disable=SC1091
. "$LIBDIR/ops.sh"
# shellcheck disable=SC1091
. "$LIBDIR/doctor.sh"
# shellcheck disable=SC1091
. "$LIBDIR/site.sh"
# shellcheck disable=SC1091
. "$LIBDIR/backup.sh"
# shellcheck disable=SC1091
. "$LIBDIR/check.sh"
# shellcheck disable=SC1091
. "$LIBDIR/platform.sh"
# shellcheck disable=SC1091
. "$LIBDIR/clone.sh"
. "$LIBDIR/pull.sh"
. "$LIBDIR/heal.sh"
. "$LIBDIR/test.sh"
. "$LIBDIR/wg.sh"
# shellcheck disable=SC1091
. "$LIBDIR/promote.sh"
# shellcheck disable=SC1091
. "$LIBDIR/d7.sh"
. "$LIBDIR/migrate.sh"
if [ -f "$LIBDIR/../apps/bee/lib.sh" ]; then
  # shellcheck disable=SC1091
  . "$LIBDIR/../apps/bee/lib.sh"
elif [ -f "$LIBDIR/bee.sh" ]; then
  # shellcheck disable=SC1091
  . "$LIBDIR/bee.sh"
fi

usage() {
  cat <<EOF
$PROG 0.4.0 — manage Backdrop platforms and sites from the shell
          (Aegir/BOA replacement, no PHP panel)

  Do not type "sudo $PROG" — refused (exit 2). Use -n before mutating commands.

  Preferred (verb first, reads as a sentence):
  $PROG pull site @host:plat/site to @host:plat/site
  $PROG pull site plat/site to plat/site
  $PROG push site @host:plat/site to @host:plat/site
  $PROG push site plat/site to plat/site [hostname NAME]
  $PROG add platform NAME from URL branch BRANCH
  $PROG add site PLATFORM PRODUCT host HOST name TITLE pass PASS
  $PROG heal site PLATFORM PRODUCT
  $PROG heal all
  $PROG list sites
  $PROG list platforms
  $PROG promote platform NAME to test
  $PROG promote platform NAME to live
  $PROG backup site PLATFORM PRODUCT
  $PROG restore site from DIR PLATFORM PRODUCT
  $PROG clone site SRC_PLAT SRC_PROD DEST_PLAT DEST_PROD host HOST
  $PROG migrate site SRC_PLAT SRC_PROD DEST_PLAT DEST_PROD [--keep]
  $PROG migrate www
  $PROG migrate-www
  $PROG debug site PLATFORM PRODUCT
  $PROG check site PLATFORM PRODUCT host HOST
  $PROG disable site PLATFORM PRODUCT
  $PROG enable site PLATFORM PRODUCT
  $PROG delete site PLATFORM PRODUCT force
  $PROG lock platform NAME
  $PROG unlock platform NAME
  $PROG verify site PLATFORM PRODUCT
  $PROG verify platform NAME
  $PROG verify all
  $PROG login-reset site PLATFORM PRODUCT
  $PROG install site PLATFORM PRODUCT          # alias of add site
  $PROG remove platform NAME
  $PROG upgrade platform NAME no-pull

  Bare words (to, from, host, name, pass, branch, role, git, force, no-pull)
  become the matching flags. The --flag form still works.

  Also accepted (object first):
  $PROG test COMMAND [args…]   # preflight, heal if safe, then run
  $PROG [-n] platform-add NAME [--git URL] [--branch BRANCH]
  $PROG [-n] platform-upgrade PLATFORM [--no-pull]
  $PROG inventory
  $PROG [-n] promote PLATFORM --to test|live
  $PROG [-n] site-add PLATFORM PRODUCT [--host HOST] [--name TITLE] [--pass PASS]
  $PROG [-n] site-backup PLATFORM PRODUCT
  $PROG [-n] site-restore [--from DIR] PLATFORM PRODUCT
  $PROG [-n] site-clone SRC_PLAT SRC_PROD DEST_PLAT DEST_PROD [--host HOST]
  $PROG [-n] site-pull [--role ROLE] VPS SRC_PLAT SRC_PROD [DEST_PLAT] [DEST_PROD]
  $PROG [-n] site-check PLATFORM PRODUCT [--host HOST]
  $PROG [-n] site-disable PLATFORM PRODUCT
  $PROG [-n] site-enable PLATFORM PRODUCT
  $PROG [-n] site-delete PLATFORM PRODUCT [--force]
  $PROG [-n] backup-all
  $PROG [-n] cron-all
  $PROG [-n] bee PLATFORM PRODUCT [bee-verb…]   # Bee with --root/--site set
  $PROG [-n] d7 VERB …   # Drupal 7 / BOA -> Backdrop (see $PROG d7 help)
  andromeda-menu          # gum / whiptail / dialog
  $PROG ui               # Textual full-screen (Aegir layout)

  log / last        task journal ($ANDROMEDA_ROOT/state/tasks.log)
                    per-run logs in $ANDROMEDA_ROOT/state/logs/YYYY-MM-DDTHH-MM-SSZ-cmd.log
                    latest.log points at the most recent; errors.log lists failures
  promote           ff-only origin/test|live on the VPS checkout, then upgrade
  backup-all        every product; prune to KEEP_BACKUPS (default 7)
  cron-all          bee --site=PRODUCT cron, staggered (installer cron.d)
  site-disable      bee maintenance-mode 1
  secrets           $ANDROMEDA_ROOT/state/secrets/<plat>/<prod> 0640 deploy:andromeda
                    (+ .cnf for mysql --defaults-extra-file; Apache cannot read)
  groups            required: www-admin andromeda
                    recommended: adm deploy
                    adm = read /var/log (not sudo); installer adds it
                    refresh: exec su - $USER   (exec bash does NOT work)
  sudo              refused if you prefix this wrapper. Root work is
                    /usr/local/sbin/andromeda-priv only.
  PHP ini           30-andromeda all SAPIs; 35-andromeda-harden FPM only;
                    35-andromeda-cli keeps Bee exec
  host extras       intl/imagick/apcu, mariadb-backup, logwatch, goaccess,
                    etckeeper, smartd, unattended-upgrades (no reboot),
                    msmtp-mta (needs /etc/msmtprc for NOTIFY)

EXIT STATUS
  0  ok (doctor READY, site-check OK)
  1  ran, but failed (missing tree, git/Bee/DB, dirty promote,
     check failed, lock held, doctor NOT READY)
  2  usage (bad flag, missing args, promote --to devel / on devel host)

EXAMPLES
  git remote add origin git@git.example:org/andromeda.git
  git push -u origin devel
  git push origin devel
  git clone -b devel git@git.example:org/andromeda.git ~/andromeda
  cd ~/andromeda && ./andromeda-install.sh -n --localhost

  $PROG doctor
  $PROG -n add platform mysite --git git@git.example:org/mysite.git
  $PROG add site mysite www --host www.devel
  $PROG backup site mysite www
  $PROG check site mysite www --host www.devel
  $PROG restore site --from $ANDROMEDA_ROOT/backups/mysite/www/devel/STAMP mysite www
  $PROG clone site mysite www mysite www-copy --host www-copy.devel
  $PROG pull site @vps:mysite/www to @local:mysite/www
  $PROG -n promote platform mysite to test
  $PROG promote platform mysite to live
  $PROG log 20
  $PROG last
  $PROG backup-all
  $PROG inventory
  $PROG site-disable mysite www && $PROG site-enable mysite www
  $PROG -n site-delete mysite www-copy
  $PROG d7 test /data/disk/o1/…/sites/example.com
  $PROG d7 /data/disk/o1/…/sites/example.com
  $PROG d7 tools
  $PROG -n d7 all --from /path/to/d7-example --platform ecom --product example --host example.devel
  andromeda-menu
  $PROG ui
  id                    # confirm www-admin andromeda
  exec su - "$USER"     # after usermod -aG (not exec bash)

  man $PROG     $PROG -h
  lib: $LIBDIR
EOF
}

while [ $# -gt 0 ]; do
  case $1 in
    -n) DRYRUN=1; shift ;;
    -h|--help)
      topic=${2:-}
      if [ -n "$topic" ]; then
        show_doc "$topic"
      else
        usage
      fi
      exit 0
      ;;
    --) shift; break ;;
    -*) echo "$PROG: unknown flag $1" >&2; exit 2 ;;
    *) break ;;
  esac
done

cmd=${1:-help}
[ $# -gt 0 ] && shift
_rest=""
for _a in "$@"; do
  if [ "$_a" = "-n" ]; then DRYRUN=1; continue; fi
  _rest="$_rest $_a"
done
# shellcheck disable=SC2086
set -- $_rest
# verb-first: pull site, add platform, heal site, list sites, promote platform
# object-first forms (site pull, platform add) remain as aliases
case $cmd in
  pull|push|add|heal|list|promote|backup|restore|clone|debug|check|disable|enable|delete|remove|upgrade|test|lock|unlock|verify|install|login-reset|migrate)
    obj=${1:-}
    case $cmd in
      pull)    case $obj in site) cmd=site-pull; shift ;; esac ;;
      push)    case $obj in site) cmd=site-push; shift ;; esac ;;
      add)     case $obj in platform) cmd=platform-add; shift ;; site) cmd=site-add; shift ;; esac ;;
      heal)    case $obj in site) cmd=site-heal; shift ;; all) cmd=heal-all; shift ;; esac ;;
      list)    case $obj in site|sites) cmd=site-list; shift ;; platform|platforms) cmd=platform-list; shift ;; esac ;;
      promote) case $obj in platform) cmd=promote; shift ;; esac ;;
      backup)  case $obj in site) cmd=site-backup; shift ;; all) cmd=backup-all; shift ;; esac ;;
      restore) case $obj in site) cmd=site-restore; shift ;; esac ;;
      clone)   case $obj in site) cmd=site-clone; shift ;; esac ;;
      debug)   case $obj in site) cmd=site-debug; shift ;; esac ;;
      check)   case $obj in site) cmd=site-check; shift ;; esac ;;
      disable) case $obj in site) cmd=site-disable; shift ;; esac ;;
      enable)  case $obj in site) cmd=site-enable; shift ;; esac ;;
      delete)  case $obj in site) cmd=site-delete; shift ;; esac ;;
      remove)  case $obj in platform) cmd=platform-remove; shift ;; esac ;;
      upgrade) case $obj in platform) cmd=platform-upgrade; shift ;; esac ;;
      lock)    case $obj in platform) cmd=platform-lock; shift ;; esac ;;
      unlock)  case $obj in platform) cmd=platform-unlock; shift ;; esac ;;
      verify)  case $obj in site) cmd=verify; shift ;; platform|all|"") cmd=verify; shift ;; esac ;;
      install) case $obj in site) cmd=site-add; shift ;; esac ;;
      login-reset) case $obj in site) cmd=site-login-reset; shift ;; esac ;;
      migrate) case $obj in www) cmd=migrate-www; shift ;; site) cmd=site-migrate; shift ;; esac ;;
    esac
    # sentence words become flags so the line reads as a sentence
    # pull keeps "to" as a separator between two @refs
    if [ "$cmd" = "site-pull" ] || [ "$cmd" = "site-push" ]; then
      _clean=
      for _a in "$@"; do
        [ "$_a" = "to" ] && continue
        _clean="$_clean $_a"
      done
      # shellcheck disable=SC2086
      set -- $_clean
    else
      _clean=
      _next=
      for _a in "$@"; do
        case $_a in
          to|from|host|hostname|name|pass|branch|role|git)
            _clean="$_clean --$_a"
            ;;
          force|no-pull)
            _clean="$_clean --$_a"
            ;;
          *)
            _clean="$_clean $_a"
            ;;
        esac
      done
      # shellcheck disable=SC2086
      set -- $_clean
    fi
    ;;
esac
# object-first aliases: site list / platform list -> the hyphen form
case $cmd in
  heal)
    if [ "${1:-}" = "all" ]; then
      cmd="heal-all"
      shift
    fi
    ;;
  migrate-www)
    if [ "${1:-}" = "heal" ]; then
      cmd="migrate-heal"
      shift
    fi
    ;;
  site|platform|backup|cron)
    verb=${1:-}
    case $verb in
      list|add|upgrade|backup|restore|clone|pull|push|debug|heal|check|disable|enable|delete|remove|all|lock|unlock|verify|migrate)
        cmd="$cmd-$verb"
        shift
        ;;
    esac
    ;;
esac

case $cmd in
  help) ;;
  doctor|list|env|log|last|inventory|ui)
    check_operator_groups || true
    ;;
  *)
    if ! check_operator_groups; then
      echo "$PROG: refusing $cmd until required groups are set" >&2
      exit 1
    fi
    ;;
esac

dispatch() {
  case $cmd in
    help) usage ;;
    doctor) cmd_doctor ;;
    list) cmd_list ;;
    platform-list) cmd_platform_list "$@" ;;
    site-list) cmd_site_list "$@" ;;
    env) cmd_env ;;
    log) cmd_log "$@" ;;
    last) cmd_last ;;
    platform-add) cmd_platform_add "$@" ;;
    platform-remove) cmd_platform_remove "$@" ;;
    migrate-www) cmd_migrate_www "$@" ;;
    migrate-heal) cmd_migrate_heal "$@" ;;
    site-migrate) cmd_site_migrate "$@" ;;
    repo-ensure) cmd_repo_ensure "$@" ;;
    platform-upgrade) cmd_platform_upgrade "$@" ;;
    promote) cmd_promote "$@" ;;
    site-add) cmd_site_add "$@" ;;
    site-backup) cmd_site_backup "$@" ;;
    site-restore) cmd_site_restore "$@" ;;
    site-clone) cmd_site_clone "$@" ;;
    site-pull) cmd_site_pull "$@" ;;
    site-push) cmd_site_push "$@" ;;
    site-debug) cmd_site_debug "$@" ;;
    site-heal) cmd_site_heal "$@" ;;
    heal-all) cmd_heal_all ;;
    site-check) cmd_site_check "$@" ;;
    test) cmd_test "$@" ;;
    site-disable) cmd_site_disable "$@" ;;
    site-enable) cmd_site_enable "$@" ;;
    site-delete) cmd_site_delete "$@" ;;
    platform-lock) cmd_platform_lock "$@" ;;
    platform-unlock) cmd_platform_unlock "$@" ;;
    verify) cmd_verify "$@" ;;
    site-login-reset) cmd_site_login_reset "$@" ;;
    inventory) cmd_inventory ;;
    ui)
      # Textual front-end. Repo layout is ../tui; installed copy is under share.
      TUI=""
      for cand in \
        "$HERE/../tui/andromeda_ui.py" \
        /usr/local/share/andromeda/tui/andromeda_ui.py \
        /usr/local/lib/andromeda/tui/andromeda_ui.py
      do
        if [ -f "$cand" ]; then
          TUI=$cand
          break
        fi
      done
      if [ -z "$TUI" ]; then
        echo "$PROG: missing Textual UI (tui/andromeda_ui.py)" >&2
        echo "$PROG: run from the repo: $HERE/andromeda ui" >&2
        return 1
      fi
      if command -v uv >/dev/null 2>&1; then
        ANDROMEDA_BIN=$HERE/andromeda exec uv run --with textual "$TUI" "$@"
      else
        ANDROMEDA_BIN=$HERE/andromeda exec python3 "$TUI" "$@"
      fi
      ;;
    backup-all) cmd_backup_all ;;
    cron-all) cmd_cron_all ;;
    bee) cmd_bee "$@" ;;
    d7|d7-migrate) cmd_d7 "$@" ;;
    d7-prep) cmd_d7 prep "$@" ;;
    d7-assess) cmd_d7 assess "$@" ;;
    d7-convert) cmd_d7 convert "$@" ;;
    d7-attach) cmd_d7 attach "$@" ;;
    d7-toolkit) cmd_d7 toolkit "$@" ;;
    d7-stubs) cmd_d7 stubs "$@" ;;
    d7-port) cmd_d7 port "$@" ;;
    d7-tools) cmd_d7 tools "$@" ;;
    d7-test) cmd_d7 test "$@" ;;
    d7-apply) cmd_d7 apply "$@" ;;
    *)
      echo "$PROG: unknown command '$cmd'" >&2
      usage >&2
      return 2
      ;;
  esac
}

case $cmd in
  platform-upgrade|site-restore|promote|backup-all|site-delete)
    open_run_log "$cmd"
    rcfile=$(mktemp)
    {
      with_lock mutate dispatch "$@"
      echo $? > "$rcfile"
    } 2>&1 | tee -a "${RUN_LOG:-/dev/null}"
    rc=$(cat "$rcfile" 2>/dev/null || echo 1)
    rm -f "$rcfile"
    task_log "$cmd $*" "$rc"
    [ "$rc" -eq 0 ] || exit "$rc"
    ;;
  site-add|site-backup|site-clone|site-pull|site-push|site-heal|site-check|site-disable|site-enable|cron-all|platform-add|platform-lock|platform-unlock|verify|site-login-reset|site-migrate|migrate-www|migrate-heal|bee|d7|d7-migrate|d7-prep|d7-assess|d7-test|d7-apply|d7-convert|d7-attach|d7-toolkit|d7-stubs|d7-port|test)
    open_run_log "$cmd"
    rcfile=$(mktemp)
    {
      dispatch "$@"
      echo $? > "$rcfile"
    } 2>&1 | tee -a "${RUN_LOG:-/dev/null}"
    rc=$(cat "$rcfile" 2>/dev/null || echo 1)
    rm -f "$rcfile"
    task_log "$cmd $*" "$rc"
    [ "$rc" -eq 0 ] || exit "$rc"
    ;;
  *)
    dispatch "$@"
    ;;
esac
