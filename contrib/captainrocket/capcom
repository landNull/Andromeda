#!/bin/sh
# contrib/captainrocket/capcom — call Capcom on the knarr LAN.
# Run from any project under $HOME/Apps, on any device.
#
#   capcom diagnose
#   capcom "run the daily tests"
#
# Host is the dnsmasq name, not an IP. First successful connect writes
# $HOME/.config/stardust/capcom.conf so the next call is already set.
#
# Config (first found):
#   $CAPCOM_CONF
#   $HOME/.config/stardust/capcom.conf
#   ./contrib/captainrocket/capcom.conf

set -eu

PROG=${0##*/}
DEFAULT_HOST="starhq.knarr"
DEFAULT_PORT="19697"
CONF_DIR="${HOME}/.config/stardust"
CONF_FILE="${CONF_DIR}/capcom.conf"

notify() {
  # Termux:API. Silent if the binary is missing.
  command -v termux-notification >/dev/null 2>&1 || return 0
  termux-notification --title "Capcom" --content "$1" >/dev/null 2>&1 || true
}

die_lan() {
  msg="you're not connected to the knarr LAN."
  printf '%s\n' "$msg"
  notify "$msg"
  exit 2
}

die_door() {
  msg="door is not open on ${HOST}:${PORT}."
  printf '%s\n' "$msg"
  notify "$msg"
  exit 2
}

load_conf() {
  HOST=""
  PORT=""
  TIMEOUT="5"
  for f in \
    "${CAPCOM_CONF:-}" \
    "$CONF_FILE" \
    "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/capcom.conf"
  do
    [ -n "$f" ] && [ -f "$f" ] || continue
    # shellcheck disable=SC1090
    . "$f"
    break
  done
  HOST="${CAPCOM_HOST:-${HOST:-$DEFAULT_HOST}}"
  PORT="${CAPCOM_PORT:-${PORT:-$DEFAULT_PORT}}"
  TIMEOUT="${CAPCOM_TIMEOUT:-$TIMEOUT}"
}

resolves() {
  # dnsmasq on knarr answers for starhq.knarr. Off the LAN it does not.
  # python3 first: Termux has no getent.
  if command -v python3 >/dev/null 2>&1; then
    python3 -c 'import socket,sys; socket.gethostbyname(sys.argv[1])' "$1" >/dev/null 2>&1 && return 0
  fi
  if command -v getent >/dev/null 2>&1; then
    getent hosts "$1" >/dev/null 2>&1 && return 0
  fi
  if command -v ping >/dev/null 2>&1; then
    ping -c 1 -W "$TIMEOUT" "$1" >/dev/null 2>&1 && return 0
  fi
  return 1
}

port_open() {
  host=$1
  port=$2
  if command -v nc >/dev/null 2>&1; then
    nc -z -w "$TIMEOUT" "$host" "$port" >/dev/null 2>&1 && return 0
  fi
  if command -v bash >/dev/null 2>&1; then
    timeout "$TIMEOUT" bash -c "echo >/dev/tcp/$host/$port" >/dev/null 2>&1 && return 0
  fi
  return 1
}

save_conf() {
  mkdir -p "$CONF_DIR"
  cat > "$CONF_FILE" << CFG
# Written by $PROG on first successful LAN connect. Safe to edit.
CAPCOM_HOST=${HOST}
CAPCOM_PORT=${PORT}
CAPCOM_TIMEOUT=${TIMEOUT}
CFG
}

project_root() {
  git rev-parse --show-toplevel 2>/dev/null || pwd
}

if [ $# -lt 1 ] || [ -z "${1:-}" ]; then
  printf 'SPEAK: Say a phrase. For example, diagnose the stack.\n'
  exit 2
fi

load_conf

# Name first. starhq.knarr only resolves on the knarr LAN via dnsmasq.
resolves "$HOST" || die_lan

# No port probe. The door is single-threaded; a probe connection blocks
# the real request and curl times out. curl itself is the open check.

save_conf

phrase=$1
root=$(project_root)
device=$(uname -n 2>/dev/null || echo unknown)

# Door expects {"text": "..."}. See CaptainRocket modules/door.py.
body=$(printf '{"text":"%s","project":"%s","device":"%s"}\n' "$phrase" "$root" "$device")

if command -v curl >/dev/null 2>&1; then
  # -4: Termux curl prefers IPv6 and times out. The door is IPv4.
  curl -4 -fsS --max-time "$TIMEOUT" \
    -H 'Content-Type: application/json' \
    -d "$body" \
    "http://$HOST:$PORT/speak" || die_door
  printf '\n'
  exit 0
fi

printf '%s\n' "$body" | nc -w "$TIMEOUT" "$HOST" "$PORT" || die_door
exit 0
