{
  "schema": "captainrocket.tools/v1",
  "repo": "github.com/landNull/Andromeda",
  "cwd": "{repo}",
  "tools": [
    {
      "name": "andromeda-tests",
      "summary": "Run Andromeda test modules the way a webadmin does.",
      "argv": [
        "./tests/run-test.sh",
        "--json",
        "--speak"
      ],
      "intents": [
        "run the daily tests",
        "run all the tests",
        "diagnose the stack",
        "check the platform",
        "check the site",
        "check security"
      ],
      "speak_prefix": "SPEAK:",
      "json_line": true,
      "exit": {
        "0": "pass",
        "1": "fail",
        "2": "usage"
      }
    },
    {
      "name": "andromeda-daily",
      "summary": "One day of webadmin work: doctor, site-add, check, backup, restore, clone.",
      "argv": [
        "./tests/run-test.sh",
        "--json",
        "--speak",
        "-n",
        "daily"
      ],
      "intents": [
        "run the daily tests",
        "webadmin day"
      ]
    },
    {
      "name": "andromeda-diagnose",
      "summary": "Host groups, deploy user, platforms dir, CLI present.",
      "argv": [
        "./tests/run-test.sh",
        "--json",
        "--speak",
        "--diagnose"
      ],
      "intents": [
        "diagnose the stack",
        "check the host"
      ]
    },
    {
      "name": "andromeda-preflight",
      "summary": "Preflight a Andromeda command. Heal if safe, then run only if the check passes.",
      "argv": [
        "./contrib/captainrocket/run-tool.sh",
        "preflight"
      ],
      "intents": [
        "preflight a command",
        "test a command"
      ],
      "speak_prefix": "SPEAK:",
      "json_line": true
    },
    {
      "name": "andromeda-heal-all",
      "summary": "Heal every site that site-debug reports as failing.",
      "argv": [
        "./contrib/captainrocket/run-tool.sh",
        "heal-all"
      ],
      "intents": [
        "heal all sites"
      ],
      "speak_prefix": "SPEAK:",
      "json_line": true
    },
    {
      "name": "andromeda-last-log",
      "summary": "Print the path of the most recent timestamped run log.",
      "argv": [
        "./contrib/captainrocket/run-tool.sh",
        "last-log"
      ],
      "intents": [
        "show the last log"
      ]
    },
    {
      "name": "starcoder-complete",
      "summary": "Complete a code prefix with starcoder2. Supports temperature, stop sequences, optional FIM suffix, and post-filter.",
      "argv": [
        "./contrib/captainrocket/starcoder-complete.sh"
      ],
      "intents": [
        "complete this code",
        "finish this function",
        "starcoder complete"
      ],
      "speak_prefix": "SPEAK:",
      "json_line": false,
      "exit": {
        "0": "pass",
        "1": "fail",
        "2": "usage"
      }
    }
  ]
}
