    "bee config export": "bee config-export",
    "bee config import": "bee config-import",
    "bee cron": "bee cron",
    "bee login": "bee uli",
    "bee enable": "bee en",
    "bee disable": "bee dis",
    "bee download module": "bee dl",
    "help bee": "bee help"
  },
  "tools": ["bee", "php"]
}
